{
  "name": "atreia-street-companion",
  "version": "0.1.4",
  "private": true,
  "description": "Account-connected Aion 2 economy and progression companion for Atreia Street",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "dist:win": "electron-builder --win nsis --x64",
    "capture:build": "dotnet publish capture/AtreiaCapture.csproj -c Release -r win-x64 --self-contained true -o capture/publish",
    "verify:ocr-dependencies": "node tests/check-ocr-dependencies.cjs"
  },
  "dependencies": {
    "tesseract.js": "6.0.1"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.atreiastreet.companion",
    "productName": "Atreia Street Companion",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "ledger.cjs",
      "periods.cjs",
      "index.html",
      "ui.js",
      "styles.css",
      "config.json",
      "discovery.cjs",
      "overlay.html",
      "overlay.css",
      "overlay.js",
      "overlay-preload.cjs",
      "wallets.js",
      "item-catalog.js",
      "item-economy.js",
      "market-ocr.cjs",
      "market-fees.cjs",
      "market-attribution.js"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "extraResources": [
      {
        "from": "capture/publish",
        "to": "capture",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "overrides": {
    "wasm-feature-detect": "1.8.0"
  }
}
