{
  "name": "atreia-street-companion",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first Aion 2 economy and progression summary for Atreia Street",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "dist:win": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.atreiastreet.companion",
    "productName": "Atreia Street Companion",
    "directories": { "output": "release" },
    "files": ["main.cjs","preload.cjs","ledger.cjs","periods.cjs","index.html","ui.js","styles.css","config.json"],
    "win": { "target": "nsis" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
