{
  "name": "atreia-street-companion",
  "version": "0.2.0",
  "private": true,
  "description": "Aion 2 companion with account-linked, game-window Market OCR and passive economy tracking",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "dist:win": "electron-builder --win nsis --x64",
    "capture:build": "dotnet publish capture/AtreiaCapture.csproj -c Release -r win-x64 --self-contained true -o capture/publish"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.atreiastreet.companion",
    "productName": "Atreia Street Companion",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "ledger.cjs",
      "periods.cjs",
      "index.html",
      "ui.js",
      "styles.css",
      "config.json",
      "discovery.cjs",
      "overlay.html",
      "overlay.css",
      "overlay.js",
      "overlay-preload.cjs",
      "wallets.js",
      "item-catalog.js",
      "item-economy.js",
      "market-ocr.cjs",
      "market-observer.cjs",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "extraResources": [
      {
        "from": "capture/publish",
        "to": "capture",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "node_modules/@tesseract.js-data/eng/4.0.0_best_int/eng.traineddata.gz",
        "to": "ocr/eng.traineddata.gz"
      }
    ],
    "asarUnpack": [
      "node_modules/tesseract.js/**",
      "node_modules/tesseract.js-core/**",
      "node_modules/@tesseract.js-data/eng/**"
    ]
  },
  "dependencies": {
    "tesseract.js": "^6.0.1",
    "@tesseract.js-data/eng": "^1.0.0"
  }
}
